# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Mac files
.DS_Store
.AppleDouble
.LSOverride

# PyTorch cache
.cache/

# Raw external datasets (avoid committing gigabytes of raw LFW/CelebA zips)
dataset/raw/*
!dataset/raw/.gitkeep

# Attendance Snapshots (keep folder structure)
attendance_records/snapshots/*
!attendance_records/snapshots/.gitkeep
